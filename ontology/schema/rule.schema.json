{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langatlas.dev/schema/rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "when_all", "effect", "then", "message", "sources", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "when_all": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "effect": { "enum": ["requires", "forbids", "warn"] },
    "then": {
      "type": "array",
      "items": { "type": "string" }
    },
    "message": { "type": "string" },
    "sources": { "$ref": "defs.schema.json#/$defs/sourcesList" },
    "provenance": { "$ref": "defs.schema.json#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "effect": { "enum": ["requires", "forbids"] } },
        "required": ["effect"]
      },
      "then": {
        "properties": { "then": { "minItems": 1 } }
      }
    }
  ]
}
